# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# claude local scratch (design refs, backups, plans)
.claude/tmp/
# ...diff/tmp files a Claude Code session can leave behind if it writes
# scratch output into the repo root instead of its scratchpad dir
*.claudetmpdiff*.txt

# stray platform binaries that shouldn't be committed to this repo
*.exe

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
satutuju/

.vercel

disc-test-content.md
